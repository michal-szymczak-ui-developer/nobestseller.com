---
import { ERAS, type Item, type Kind, type ListInfo } from '../lib/data';
interface Props { items: Item[]; lists: ListInfo[]; }
const { items, lists } = Astro.props;

const KINDS: { kind: Kind; label: string; title: string; ageLabel: string }[] = [
  { kind: 'books', label: 'Książki', title: 'Rekomendowane książki', ageLabel: 'Wiek czytelnika' },
  { kind: 'movies', label: 'Filmy', title: 'Rekomendowane filmy', ageLabel: 'Wiek widza' },
];

interface Option { value: string; label: string; count: number; }
interface Group { key: string; label: string; options: Option[]; }

const tally = (xs: string[]) => {
  const m = new Map<string, number>();
  xs.forEach((x) => m.set(x, (m.get(x) ?? 0) + 1));
  return m;
};

function groupsFor(kind: Kind, ageLabel: string): Group[] {
  const its = items.filter((i) => i.kind === kind);
  const byCount = (a: Option, b: Option) => b.count - a.count || a.label.localeCompare(b.label, 'pl');
  const listOpts = lists.filter((l) => l.kind === kind).map((l) => ({
    value: l.slug, label: l.title, count: its.filter((i) => i.lists.some((x) => x.slug === l.slug)).length,
  }));
  const genre = [...tally(its.map((i) => i.genre))].map(([v, c]) => ({ value: v, label: v, count: c })).sort(byCount);
  const eraCounts = tally(its.map((i) => i.era));
  const era = ERAS[kind].filter((e) => eraCounts.has(e)).map((e) => ({ value: e, label: e, count: eraCounts.get(e)! }));
  const ageCounts = tally(its.map((i) => String(i.ageNum)));
  const age = [...ageCounts].filter(([v]) => v !== '0').sort((a, b) => +a[0] - +b[0])
    .map(([v, c]) => ({ value: v, label: `od ${v} lat`, count: c }));
  const ptsCounts = tally(its.map((i) => String(i.lists.length)));
  const pts = [...ptsCounts].sort((a, b) => +a[0] - +b[0])
    .map(([v, c]) => ({ value: v, label: v === '1' ? 'na 1 liście' : `na ${v} listach`, count: c }));
  return [
    { key: 'list', label: 'Źródło listy', options: listOpts },
    { key: 'genre', label: 'Gatunek', options: genre },
    { key: 'era', label: kind === 'books' ? 'Epoka' : 'Dekada', options: era },
    { key: 'age', label: ageLabel, options: age },
    { key: 'pts', label: 'Polecane', options: pts },
  ].filter((g) => g.options.length > 1);
}

const hue = (s: string) => {
  let h = 5381;
  for (const c of s) h = ((h << 5) + h + c.charCodeAt(0)) >>> 0;
  return h % 360;
};
const listsWord = (n: number) => (n < 5 ? 'listy' : 'list');
const lastName = (s: string) => s.split(/[,;]/)[0].trim().split(' ').pop() ?? '';

const sorted = [...items].sort((a, b) => b.lists.length - a.lists.length || a.title.localeCompare(b.title, 'pl'));
---
<nav class="topbar">
  <a href="/" class="wordmark">nobestseller</a>
  <div class="switch" role="tablist" aria-label="Rodzaj">
    {KINDS.map(({ kind, label }) => (
      <button type="button" role="tab" data-kind-btn={kind} aria-selected="false">{label}</button>
    ))}
  </div>
  <div class="topbar-right">
    <span class="topbar-count" id="topbar-count"></span>
    <button type="button" class="theme-btn" id="theme" aria-label="Przełącz motyw jasny/ciemny" title="Motyw">
      <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</nav>

<div class="shell">
  <aside class="sidebar">
    <div class="search-wrap">
      <input class="search-input" type="search" id="q" placeholder="Szukaj tytułu, autora…" autocomplete="off" />
    </div>

    {KINDS.map(({ kind, ageLabel }) => (
      <div class="panel" data-panel={kind} hidden>
        {groupsFor(kind, ageLabel).map((g) => (
          <div class="sidebar-section" data-group={g.key}>
            <span class="sidebar-label">{g.label}</span>
            <ul class="filter-list">
              {g.options.map((o) => (
                <li class="filter-item">
                  <label><input type="checkbox" value={o.value} /> {o.label}</label>
                  <span class="filter-count">{o.count}</span>
                </li>
              ))}
            </ul>
            <button type="button" class="clear-btn" data-clear={g.key}>Wyczyść</button>
          </div>
        ))}
      </div>
    ))}
  </aside>

  <main class="main">
    <div class="list-header">
      <div>
        <h1 class="list-title" id="title"></h1>
        <div class="list-sub" id="sub" aria-live="polite"></div>
      </div>
      <div class="sort-wrap">
        <label class="sort-label" for="sort">Sortuj</label>
        <select class="sort-select" id="sort">
          <option value="pop">Najczęściej polecane</option>
          <option value="year-asc">Rok (rosnąco)</option>
          <option value="year-desc">Rok (malejąco)</option>
          <option value="title">Tytuł A–Z</option>
          <option value="age">Wiek (rosnąco)</option>
        </select>
      </div>
    </div>

    <ul class="rows" id="rows">
      {sorted.map((i) => (
        <li class="row" hidden data-kind={i.kind} data-genre={i.genre} data-era={i.era} data-age={i.ageNum}
            data-pts={i.lists.length} data-lists={i.lists.map((l) => l.slug).join(' ')}
            data-title={i.title} data-year={i.yearNum}
            data-text={`${i.title} ${i.originalTitle} ${i.creator} ${i.country} ${i.description}`.toLowerCase()}>
          <div class="cover" style={`--h:${hue(i.title + i.creator)}`} aria-hidden="true">
            <span class="c-title">{i.title}</span>
            <span class="c-by">{lastName(i.creator)}</span>
          </div>
          <div class="info">
            <h2 class="item-title">{i.title}</h2>
            <div class="by">{i.creator}{i.originalTitle && <><span>·</span><em>{i.originalTitle}</em></>}</div>
            <p class="desc">{i.description}</p>
            <div class="tags">
              {i.lists.length === 1 && (
                <button type="button" class="src-badge src-tag" data-list={i.lists[0].slug} title="Pokaż tylko tę listę">{i.lists[0].title}</button>
              )}
              {i.lists.length > 1 && (
                <span class="tip-wrap">
                  <span class="points-badge" tabindex="0" aria-haspopup="true">{i.lists.length} {listsWord(i.lists.length)}</span>
                  <span class="tip" role="tooltip">
                    <span class="tip-box">
                      {i.lists.map((l) => <button type="button" class="src-badge" data-list={l.slug} title="Pokaż tylko tę listę">{l.title}</button>)}
                    </span>
                  </span>
                </span>
              )}
              <span class="tag">{i.genre}</span>
              {i.country && <span class="tag">{i.country}</span>}
              {i.age && <span class="tag">{i.age}</span>}
            </div>
          </div>
          <div class="side">
            <span class="year">{i.year}</span>
          </div>
        </li>
      ))}
    </ul>
    <div class="empty" id="empty" hidden><p>Brak wyników dla wybranych filtrów.</p></div>
  </main>
</div>

<style>
  /* ─── Pasek górny ───────────────────────────────────── */
  .topbar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 40px; height: 52px; border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; background: var(--bg); z-index: 200;
  }
  .wordmark {
    font-family: 'Playfair Display Variable', serif; font-size: 18px; font-weight: 700;
    letter-spacing: -0.5px; color: var(--ink); text-decoration: none; justify-self: start;
  }
  .switch { display: flex; border: 1px solid var(--rule); }
  .switch button {
    background: none; border: 0; padding: 6px 22px; font-size: 13px; color: var(--ink-mid);
    cursor: pointer; transition: background .1s, color .1s;
  }
  .switch button + button { border-left: 1px solid var(--rule); }
  .switch button[aria-selected='true'] { background: var(--ink); color: var(--bg); }
  .switch button:hover:not([aria-selected='true']) { background: var(--hover); color: var(--ink); }
  .topbar-right { display: flex; align-items: center; gap: 16px; justify-self: end; }
  .topbar-count { font-size: 12px; color: var(--ink-faint); }
  .theme-btn {
    width: 32px; height: 32px; display: grid; place-items: center; background: none;
    border: 1px solid var(--rule); color: var(--ink-mid); cursor: pointer;
  }
  .theme-btn:hover { border-color: var(--ink); color: var(--ink); }
  .theme-btn .i-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-btn .i-sun { display: block; }
  :global(:root[data-theme='dark']) .theme-btn .i-moon { display: none; }
  button:focus-visible, select:focus-visible, input:focus-visible, a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* ─── Układ ─────────────────────────────────────────── */
  .shell { display: grid; grid-template-columns: 360px 1fr; min-height: calc(100vh - 52px); }
  .sidebar {
    border-right: 1px solid var(--rule); padding: 24px 0; position: sticky; top: 52px;
    height: calc(100vh - 52px); overflow-y: auto;
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: var(--rule); }
  .search-wrap { padding: 0 24px; margin-bottom: 20px; }
  .search-input {
    width: 100%; padding: 8px 10px; font-size: 13px; border: 1px solid var(--rule);
    border-radius: 0; background: var(--hover); outline: none;
  }
  .search-input::placeholder { color: var(--ink-faint); }
  .search-input:focus { border-color: var(--ink); background: var(--bg); }
  .panel[hidden], .row[hidden], .empty[hidden] { display: none; }

  .sidebar-section { padding: 24px 24px 0; margin-bottom: 4px; border-top: 1px solid var(--rule); }
  .sidebar-label {
    display: block; font-size: 10px; font-weight: 500; letter-spacing: .08em;
    color: var(--ink-faint); text-transform: uppercase; margin-bottom: 12px;
  }
  .filter-list { list-style: none; }
  .filter-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 0; }
  .filter-item label {
    display: flex; align-items: center; gap: 9px; cursor: pointer; font-size: 13px; color: var(--ink-mid);
  }
  .filter-item:hover label, .filter-item:has(input:checked) label { color: var(--ink); }
  .filter-item:has(input:checked) label { font-weight: 500; }
  .filter-item input[type='checkbox'] {
    appearance: none; width: 14px; height: 14px; border: 1px solid var(--rule-strong); border-radius: 0;
    flex-shrink: 0; cursor: pointer; position: relative; background: transparent;
  }
  .filter-item input[type='checkbox']:checked { background: var(--ink); border-color: var(--ink); }
  .filter-item input[type='checkbox']:checked::after {
    content: ''; position: absolute; top: 1px; left: 4px; width: 4px; height: 7px;
    border: solid var(--bg); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg);
  }
  .filter-count { font-size: 11px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .clear-btn {
    display: none; background: none; border: 0; font-size: 12px; color: var(--ink-faint);
    cursor: pointer; text-decoration: underline; margin: 6px 0 12px;
  }
  .clear-btn.visible { display: block; }

  /* ─── Wyniki ────────────────────────────────────────── */
  .list-header {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 28px 36px 20px; border-bottom: 1px solid var(--rule);
  }
  .list-title { font-family: 'Playfair Display Variable', serif; font-size: 22px; font-weight: 700; letter-spacing: -.4px; }
  .list-sub { font-size: 12px; color: var(--ink-faint); }
  .sort-wrap { display: flex; align-items: center; gap: 8px; }
  .sort-label { font-size: 12px; color: var(--ink-faint); }
  .sort-select {
    font-size: 12px; border: 1px solid var(--rule); padding: 4px 8px; border-radius: 0;
    background: var(--bg); cursor: pointer;
  }
  .rows { list-style: none; }
  .row {
    display: grid; grid-template-columns: 88px 1fr auto; align-items: start; gap: 0 20px;
    padding: 24px 36px; border-bottom: 1px solid var(--rule); transition: background .1s;
  }
  .row:hover { background: var(--hover); }

  /* płaska okładka generowana z tytułu */
  .cover {
    width: 88px; height: 132px; display: flex; flex-direction: column; justify-content: space-between;
    padding: 10px 8px 8px; overflow: hidden; color: #fff;
    background: hsl(var(--h) var(--cover-s) var(--cover-l));
  }
  .c-title {
    font-family: 'Playfair Display Variable', serif; font-weight: 700; font-size: 12px; line-height: 1.2;
    display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; hyphens: auto;
  }
  .c-by { font-size: 8px; letter-spacing: .1em; text-transform: uppercase; opacity: .85; border-top: 1px solid rgba(255,255,255,.4); padding-top: 5px; }

  .info { padding-top: 2px; min-width: 0; }

  /* tooltip z listami przy pozycjach polecanych w kilku źródłach – pozycjonowany względem plakietki */
  .tip-wrap { position: relative; display: inline-flex; }
  .points-badge { cursor: default; }
  .tip {
    position: absolute; left: 0; bottom: 100%; padding-bottom: 6px; z-index: 50;
    visibility: hidden; opacity: 0; transition: opacity .12s, visibility .12s;
  }
  .tip-wrap:hover .tip, .tip-wrap:focus-within .tip { visibility: visible; opacity: 1; }
  .tip-box {
    display: flex; flex-direction: column; align-items: flex-start; gap: 4px; white-space: nowrap;
    background: var(--ink); color: var(--bg); padding: 8px 12px;
  }
  .tip .src-badge { color: var(--bg); opacity: .85; }
  .tip .src-badge:hover { color: var(--bg); opacity: 1; }
  .src-badge {
    background: none; border: 0; padding: 0; font-size: 10px; font-weight: 500; letter-spacing: .06em;
    color: var(--ink-faint); text-transform: uppercase; cursor: pointer;
  }
  .src-badge:hover { color: var(--ink); text-decoration: underline; }
  /* nazwa jedynej listy – na miejscu plakietki „N listy”, w jej wymiarach (obrys zamiast wypełnienia) */
  .src-tag {
    font-size: 11px; font-weight: 600; text-transform: none; letter-spacing: .04em; line-height: inherit;
    color: var(--ink); border: 1px solid var(--ink); padding: 2px 8px;
  }
  .src-tag:hover { background: var(--ink); color: var(--bg); text-decoration: none; }
  .points-badge { font-size: 11px; font-weight: 600; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); padding: 2px 8px; letter-spacing: .04em; }
  .item-title {
    font-family: 'Playfair Display Variable', serif; font-size: 19px; font-weight: 700;
    line-height: 1.25; letter-spacing: -.3px; margin-bottom: 3px;
  }
  .by { font-size: 13px; color: var(--ink-mid); margin-bottom: 10px; }
  .by span { color: var(--ink-faint); margin: 0 6px; }
  .by em { color: var(--ink-faint); }
  .desc {
    font-size: 13px; color: var(--ink-mid); line-height: 1.6; max-width: 600px;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; }
  .tag { font-size: 11px; color: var(--ink-faint); border: 1px solid var(--rule); padding: 2px 8px; }
  .side { padding-top: 4px; text-align: right; }
  .year { font-size: 12px; color: var(--ink-faint); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .empty { padding: 80px 36px; text-align: center; color: var(--ink-faint); }

  @media (max-width: 860px) {
    .topbar { padding: 0 16px; }
    .topbar-count { display: none; }
    .shell { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--rule); }
    .list-header { padding: 20px 16px 16px; }
    .row { grid-template-columns: 88px 1fr; padding: 20px 16px; gap: 0 16px; }
    .side { display: none; }
  }
</style>

<script>
  type Kind = 'books' | 'movies';
  const GROUPS = ['list', 'genre', 'era', 'age', 'pts'] as const;
  const URL_KIND: Record<Kind, string> = { books: 'ksiazki', movies: 'filmy' };
  const KIND_TITLE: Record<Kind, string> = { books: 'Rekomendowane książki', movies: 'Rekomendowane filmy' };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const rowsEl = $('rows');
  const rows = [...rowsEl.querySelectorAll<HTMLElement>('.row')];
  const qEl = $<HTMLInputElement>('q');
  const sortEl = $<HTMLSelectElement>('sort');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-kind-btn]')];
  const panels = Object.fromEntries(
    [...document.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p]),
  ) as Record<Kind, HTMLElement>;

  const boxes = (kind: Kind, g: string) =>
    [...panels[kind].querySelectorAll<HTMLInputElement>(`[data-group="${g}"] input[type=checkbox]`)];
  const checked = (kind: Kind, g: string) => boxes(kind, g).filter((b) => b.checked).map((b) => b.value);

  // ─── Stan z adresu: ?t=filmy&genre=Dramat&genre=Komedia&q=… ───
  const params = new URLSearchParams(location.search);
  let kind: Kind = params.get('t') === URL_KIND.movies ? 'movies' : 'books';
  qEl.value = params.get('q') ?? '';
  sortEl.value = params.get('sort') ?? 'pop';
  if (!sortEl.value) sortEl.value = 'pop';
  GROUPS.forEach((g) => {
    const sel = params.getAll(g);
    boxes(kind, g).forEach((b) => { b.checked = sel.includes(b.value); });
  });

  const pl = (a: string, b: string) => a.localeCompare(b, 'pl');
  const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);
  const cmp: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    pop: (a, b) => num(b, 'pts') - num(a, 'pts') || pl(a.dataset.title!, b.dataset.title!),
    'year-asc': (a, b) => num(a, 'year') - num(b, 'year'),
    'year-desc': (a, b) => num(b, 'year') - num(a, 'year'),
    title: (a, b) => pl(a.dataset.title!, b.dataset.title!),
    age: (a, b) => num(a, 'age') - num(b, 'age') || pl(a.dataset.title!, b.dataset.title!),
  };

  function apply() {
    const q = qEl.value.trim().toLowerCase();
    const sel = Object.fromEntries(GROUPS.map((g) => [g, checked(kind, g)])) as Record<(typeof GROUPS)[number], string[]>;

    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.kindBtn === kind)));
    (Object.keys(panels) as Kind[]).forEach((k) => { panels[k].hidden = k !== kind; });
    GROUPS.forEach((g) => {
      panels[kind].querySelector<HTMLElement>(`[data-clear="${g}"]`)?.classList.toggle('visible', sel[g].length > 0);
    });

    let shown = 0, total = 0, multi = 0;
    const visible: HTMLElement[] = [];
    for (const r of rows) {
      const d = r.dataset;
      if (d.kind !== kind) { r.hidden = true; continue; }
      total++;
      if (Number(d.pts) > 1) multi++;
      const ok =
        (!q || d.text!.includes(q)) &&
        (!sel.genre.length || sel.genre.includes(d.genre!)) &&
        (!sel.era.length || sel.era.includes(d.era!)) &&
        (!sel.age.length || sel.age.includes(d.age!)) &&
        (!sel.pts.length || sel.pts.includes(d.pts!)) &&
        (!sel.list.length || d.lists!.split(' ').some((s) => sel.list.includes(s)));
      r.hidden = !ok;
      if (ok) { shown++; visible.push(r); }
    }
    visible.sort(cmp[sortEl.value] ?? cmp.pop);
    visible.forEach((r) => rowsEl.appendChild(r));

    $('title').textContent = KIND_TITLE[kind];
    $('sub').textContent = `Wyświetlono ${shown} z ${total} pozycji`;
    $('topbar-count').textContent = `${total} pozycji — ${multi} na wielu listach`;
    $('empty').hidden = shown > 0;
    document.title = `${kind === 'books' ? 'Książki' : 'Filmy'} · nobestseller.com`;

    const next = new URLSearchParams();
    next.set('t', URL_KIND[kind]);
    if (q) next.set('q', qEl.value.trim());
    if (sortEl.value !== 'pop') next.set('sort', sortEl.value);
    GROUPS.forEach((g) => sel[g].forEach((v) => next.append(g, v)));
    history.replaceState(null, '', `?${next}`);
  }

  tabs.forEach((t) => t.addEventListener('click', () => { kind = t.dataset.kindBtn as Kind; apply(); }));
  qEl.addEventListener('input', apply);
  sortEl.addEventListener('change', apply);
  GROUPS.forEach((g) => (Object.keys(panels) as Kind[]).forEach((k) =>
    boxes(k, g).forEach((b) => b.addEventListener('change', apply))));
  document.querySelectorAll<HTMLElement>('[data-clear]').forEach((btn) => btn.addEventListener('click', () => {
    boxes(kind, btn.dataset.clear!).forEach((b) => { b.checked = false; });
    apply();
  }));
  // Klik w nazwę listy na karcie – pokaż tylko tę listę
  rowsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.src-badge');
    if (!b) return;
    boxes(kind, 'list').forEach((c) => { c.checked = c.value === b.dataset.list; });
    apply();
  });

  $('theme').addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  apply();
</script>
