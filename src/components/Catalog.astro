---
import Topbar from './Topbar.astro';
import { ERAS, type Item, type Kind, type ListInfo } from '../lib/data';
import { payloadJson } from '../lib/row';
interface Props { items: Item[]; lists: ListInfo[]; }
const { items, lists } = Astro.props;

const KINDS: { kind: Kind; label: string; title: string; ageLabel: string }[] = [
  { kind: 'books', label: 'Książki', title: 'Rekomendowane książki', ageLabel: 'Wiek czytelnika' },
  { kind: 'movies', label: 'Filmy', title: 'Rekomendowane filmy', ageLabel: 'Wiek widza' },
];

interface Option { value: string; label: string; count: number; }
interface Group { key: string; label: string; options: Option[]; }

const tally = (xs: string[]) => {
  const m = new Map<string, number>();
  xs.forEach((x) => m.set(x, (m.get(x) ?? 0) + 1));
  return m;
};

function groupsFor(kind: Kind, ageLabel: string): Group[] {
  const its = items.filter((i) => i.kind === kind);
  const byCount = (a: Option, b: Option) => b.count - a.count || a.label.localeCompare(b.label, 'pl');
  const listOpts = lists.filter((l) => l.kind === kind).map((l) => ({
    value: l.slug, label: l.title, count: its.filter((i) => i.lists.some((x) => x.slug === l.slug)).length,
  }));
  const genre = [...tally(its.map((i) => i.genre))].map(([v, c]) => ({ value: v, label: v, count: c })).sort(byCount);
  const eraCounts = tally(its.map((i) => i.era));
  const era = ERAS[kind].filter((e) => eraCounts.has(e)).map((e) => ({ value: e, label: e, count: eraCounts.get(e)! }));
  const ageCounts = tally(its.map((i) => String(i.ageNum)));
  const age = [...ageCounts].filter(([v]) => v !== '0').sort((a, b) => +a[0] - +b[0])
    .map(([v, c]) => ({ value: v, label: `od ${v} lat`, count: c }));
  const ptsCounts = tally(its.map((i) => String(i.lists.length)));
  const pts = [...ptsCounts].sort((a, b) => +a[0] - +b[0])
    .map(([v, c]) => ({ value: v, label: v === '1' ? 'na 1 liście' : `na ${v} listach`, count: c }));
  return [
    { key: 'list', label: 'Źródło listy', options: listOpts },
    { key: 'genre', label: 'Gatunek', options: genre },
    { key: 'era', label: kind === 'books' ? 'Epoka' : 'Dekada', options: era },
    { key: 'age', label: ageLabel, options: age },
    { key: 'pts', label: 'Polecane', options: pts },
  ].filter((g) => g.options.length > 1);
}

const dataJson = payloadJson(items);
---
<script is:inline type="application/json" id="catalog-data" set:html={dataJson} />
<Topbar current="catalog">
  <div class="switch" slot="center" role="tablist" aria-label="Rodzaj">
    {KINDS.map(({ kind, label }) => (
      <button type="button" role="tab" data-kind-btn={kind} aria-selected="false">{label}</button>
    ))}
  </div>
</Topbar>

<div class="shell">
  <div class="backdrop" id="backdrop" hidden></div>
  <aside class="sidebar" id="sidebar" aria-label="Filtry">
    <div class="drawer-head">
      <span class="drawer-title">Filtry</span>
      <button type="button" class="drawer-close" id="drawer-close" aria-label="Zamknij filtry">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
    <div class="search-wrap">
      <input class="search-input" type="search" id="q" placeholder="Szukaj tytułu, autora…" autocomplete="off" />
    </div>

    {KINDS.map(({ kind, ageLabel }) => (
      <div class="panel" data-panel={kind} hidden>
        {groupsFor(kind, ageLabel).map((g) => (
          <div class="sidebar-section" data-group={g.key}>
            <span class="sidebar-label">{g.label}</span>
            {g.key === 'list' ? (
              <div class="msel">
                <button type="button" class="msel-btn" aria-haspopup="true" aria-expanded="false">
                  <span class="msel-text">Wszystkie listy</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <ul class="filter-list msel-menu" hidden>
                  {g.options.map((o) => (
                    <li class="filter-item">
                      <label><input type="checkbox" value={o.value} /> {o.label}</label>
                      <span class="filter-count">{o.count}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <ul class="filter-list">
                {g.options.map((o) => (
                  <li class="filter-item">
                    <label><input type="checkbox" value={o.value} /> {o.label}</label>
                    <span class="filter-count">{o.count}</span>
                  </li>
                ))}
              </ul>
            )}
            <button type="button" class="clear-btn" data-clear={g.key}>Wyczyść</button>
          </div>
        ))}
      </div>
    ))}
    <div class="drawer-foot">
      <button type="button" class="drawer-apply" id="drawer-apply">Pokaż wyniki</button>
    </div>
  </aside>

  <main class="main">
    <div class="list-header">
      <div>
        <h1 class="list-title" id="title"></h1>
        <div class="list-sub" id="sub" aria-live="polite"></div>
      </div>
      <button type="button" class="filters-btn" id="filters-btn" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        Filtry <span class="filters-n" id="filters-n" hidden></span>
      </button>
      <div class="sort-wrap">
        <label class="sort-label" for="sort">Sortuj</label>
        <select class="sort-select" id="sort">
          <option value="pop">Najczęściej polecane</option>
          <option value="year-asc">Rok (rosnąco)</option>
          <option value="year-desc">Rok (malejąco)</option>
          <option value="title">Tytuł A–Z</option>
          <option value="age">Wiek (rosnąco)</option>
        </select>
      </div>
    </div>

    <div class="chips" id="chips" aria-label="Aktywne filtry" hidden></div>

    <ul class="rows" id="rows"></ul>
    <div class="more-wrap"><button type="button" class="more-btn" id="more" hidden>Pokaż więcej</button></div>
    <div class="empty" id="empty" hidden><p>Brak wyników dla wybranych filtrów.</p></div>
  </main>
</div>

<style>
  .switch { display: flex; gap: 4px; }
  .switch button {
    background: none; border: 1px solid var(--rule); padding: 0 22px; font-size: 13px; color: var(--ink-mid);
    cursor: pointer; transition: background .1s, color .1s;
  }
  .switch button[aria-selected='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .switch button:hover:not([aria-selected='true']) { background: var(--hover); color: var(--ink); }
  button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* ─── Układ ─────────────────────────────────────────── */
  .shell { display: grid; grid-template-columns: 360px 1fr; min-height: calc(100vh - 52px); }
  .sidebar {
    border-right: 1px solid var(--rule); padding: 24px 0; position: sticky; top: 52px;
    height: calc(100vh - 52px); overflow-y: auto;
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: var(--rule); }
  .search-wrap { padding: 0 24px; margin-bottom: 20px; }
  .search-input {
    width: 100%; padding: 8px 10px; font-size: 13px; border: 1px solid var(--rule);
    border-radius: 0; background: var(--hover); outline: none;
  }
  .search-input::placeholder { color: var(--ink-faint); }
  .search-input:focus { border-color: var(--ink); background: var(--bg); }
  .panel[hidden], .empty[hidden] { display: none; }

  .sidebar-section { padding: 24px 24px 0; margin-bottom: 4px; border-top: 1px solid var(--rule); }
  .sidebar-label {
    display: block; font-size: 10px; font-weight: 500; letter-spacing: .08em;
    color: var(--ink-faint); text-transform: uppercase; margin-bottom: 12px;
  }
  .filter-list { list-style: none; }
  .filter-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 0; }
  .filter-item label {
    display: flex; align-items: center; gap: 9px; cursor: pointer; font-size: 13px; color: var(--ink-mid);
  }
  .filter-item:hover label, .filter-item:has(input:checked) label { color: var(--ink); }
  .filter-item:has(input:checked) label { font-weight: 500; }
  .filter-item input[type='checkbox'] {
    appearance: none; width: 14px; height: 14px; border: 1px solid var(--rule-strong); border-radius: 0;
    flex-shrink: 0; cursor: pointer; position: relative; background: transparent;
  }
  .filter-item input[type='checkbox']:checked { background: var(--ink); border-color: var(--ink); }
  .filter-item input[type='checkbox']:checked::after {
    content: ''; position: absolute; top: 1px; left: 4px; width: 4px; height: 7px;
    border: solid var(--bg); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg);
  }
  /* „Źródło listy”: rozwijany select wielokrotnego wyboru zamiast długiej listy checkboxów */
  .msel { position: relative; }
  .msel-btn {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; text-align: left;
    padding: 8px 10px; font-size: 13px; background: var(--bg); border: 1px solid var(--rule); border-radius: 0;
    color: var(--ink); cursor: pointer;
  }
  .msel-btn:hover, .msel-btn[aria-expanded='true'] { border-color: var(--ink); }
  .msel-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .msel-btn svg { flex-shrink: 0; transition: transform .12s; }
  .msel-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .msel-menu {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 20; margin-top: 2px; padding: 6px 10px;
    max-height: 280px; overflow-y: auto; background: var(--bg); border: 1px solid var(--ink);
  }
  .msel-menu[hidden] { display: none; }
  .filter-count { font-size: 11px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .clear-btn {
    display: none; background: none; border: 0; font-size: 12px; color: var(--ink-faint);
    cursor: pointer; text-decoration: underline; margin: 6px 0 12px;
  }
  .clear-btn.visible { display: block; }

  /* ─── Wyniki ────────────────────────────────────────── */
  .list-header {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 28px 36px 20px; border-bottom: 1px solid var(--rule);
  }
  .list-title { font-family: 'Playfair Display Variable', serif; font-size: 22px; font-weight: 700; letter-spacing: -.4px; }
  .list-sub { font-size: 12px; color: var(--ink-faint); }
  .sort-wrap { display: flex; align-items: center; gap: 8px; }
  .sort-label { font-size: 12px; color: var(--ink-faint); }
  .sort-select {
    font-size: 12px; border: 1px solid var(--rule); padding: 4px 8px; border-radius: 0;
    background: var(--bg); cursor: pointer;
  }
  /* aktywne filtry nad listą – małe badge z możliwością usunięcia */
  .chips {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 12px 36px;
    border-bottom: 1px solid var(--rule);
  }
  .chips[hidden] { display: none; }
  /* elementy tworzone w JS nie mają atrybutu zakresu Astro, stąd :global */
  .chips :global(.chip) {
    display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 2px 4px 2px 10px;
    font-size: 12px; color: var(--ink); background: var(--hover); border: 1px solid var(--rule-strong); cursor: pointer;
  }
  .chips :global(.chip:hover) { border-color: var(--ink); }
  .chips :global(.chip-key) { color: var(--ink-faint); }
  .chips :global(.chip-text) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chips :global(.chip-x) { display: grid; place-items: center; width: 16px; height: 16px; color: var(--ink-mid); font-size: 14px; line-height: 1; }
  .chips :global(.chip:hover .chip-x) { color: var(--ink); }
  .chips :global(.chips-clear) {
    background: none; border: 0; padding: 2px 6px; font-size: 12px; color: var(--ink-faint);
    text-decoration: underline; cursor: pointer;
  }
  .chips :global(.chips-clear:hover) { color: var(--ink); }
  .chips :global(button:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; }
  .rows { list-style: none; }
  .more-wrap { padding: 28px 36px 40px; text-align: center; }
  .more-btn {
    padding: 9px 22px; font-size: 13px; background: none; border: 1px solid var(--ink); color: var(--ink); cursor: pointer;
  }
  .more-btn:hover { background: var(--ink); color: var(--bg); }
  .more-btn[hidden] { display: none; }
  .empty { padding: 80px 36px; text-align: center; color: var(--ink-faint); }

  /* elementy drawera – na desktopie niewidoczne */
  .drawer-head, .drawer-foot, .filters-btn { display: none; }
  .backdrop[hidden] { display: none; }

  @media (max-width: 860px) {
    .shell { grid-template-columns: 1fr; }

    /* filtry jako wysuwany drawer z lewej */
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0; height: 100dvh; width: min(360px, 88vw);
      z-index: 300; background: var(--bg); border-right: 1px solid var(--rule); padding: 0;
      display: flex; flex-direction: column;
      transform: translateX(-100%); visibility: hidden;
      transition: transform .22s ease, visibility 0s linear .22s;
    }
    .sidebar.open { transform: none; visibility: visible; transition: transform .22s ease; }
    .backdrop {
      position: fixed; inset: 0; z-index: 250; background: rgba(0,0,0,.45);
    }
    .drawer-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px 14px 24px; border-bottom: 1px solid var(--rule); flex-shrink: 0;
    }
    .drawer-title { font-family: 'Playfair Display Variable', serif; font-size: 18px; font-weight: 700; }
    .drawer-close {
      width: 36px; height: 36px; display: grid; place-items: center; background: none;
      border: 1px solid var(--rule); color: var(--ink-mid); cursor: pointer;
    }
    .search-wrap { padding: 16px 24px 0; margin-bottom: 16px; }
    .panel { flex: 1 0 auto; }
    .drawer-foot {
      display: block; position: sticky; bottom: 0; margin-top: auto; padding: 12px 24px;
      background: var(--bg); border-top: 1px solid var(--rule);
    }
    .drawer-apply {
      width: 100%; padding: 10px; font-size: 13px; background: var(--ink); color: var(--bg);
      border: 1px solid var(--ink); cursor: pointer;
    }
    .filters-btn {
      display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: 12px;
      background: none; border: 1px solid var(--rule); color: var(--ink); cursor: pointer;
    }
    .filters-btn:hover { border-color: var(--ink); }
    .filters-n {
      min-width: 16px; padding: 0 4px; font-size: 10px; line-height: 16px; text-align: center;
      background: var(--ink); color: var(--bg);
    }
    .filters-n[hidden] { display: none; }
    :global(html.drawer-open) { overflow: hidden; }

    .chips { padding: 10px 16px; }
    .list-header { padding: 20px 16px 16px; align-items: center; }
    .list-header > div:first-child { flex: 1 1 100%; }
  }

  @media (max-width: 560px) {
    .switch button { padding: 6px 14px; }
    .list-title { font-size: 19px; }
    .sort-wrap { margin-left: auto; }
  }
</style>

<script>
  import { bindRows, subscribe, syncRow } from '../lib/favorites';
  import { rowHtml, searchText, type DataPayload, type RowItem } from '../lib/row';

  type Kind = 'books' | 'movies';
  const PAGE = 100; // tyle kart doładowuje się naraz (leniwe ładowanie)
  const GROUPS = ['list', 'genre', 'era', 'age', 'pts'] as const;
  const URL_KIND: Record<Kind, string> = { books: 'ksiazki', movies: 'filmy' };
  const KIND_TITLE: Record<Kind, string> = { books: 'Rekomendowane książki', movies: 'Rekomendowane filmy' };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const rowsEl = $('rows');
  const moreEl = $<HTMLButtonElement>('more');
  const { items, titles } = JSON.parse($('catalog-data').textContent!) as DataPayload;
  const texts = new Map(items.map((i) => [i.id, searchText(i)]));
  const totals: Record<Kind, number> = { books: 0, movies: 0 };
  items.forEach((i) => { totals[i.kind]++; });
  const qEl = $<HTMLInputElement>('q');
  const sortEl = $<HTMLSelectElement>('sort');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-kind-btn]')];
  const panels = Object.fromEntries(
    [...document.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p]),
  ) as Record<Kind, HTMLElement>;

  const boxes = (kind: Kind, g: string) =>
    [...panels[kind].querySelectorAll<HTMLInputElement>(`[data-group="${g}"] input[type=checkbox]`)];
  const checked = (kind: Kind, g: string) => boxes(kind, g).filter((b) => b.checked).map((b) => b.value);

  // ─── Stan z adresu: ?t=filmy&genre=Dramat&genre=Komedia&q=… ───
  const params = new URLSearchParams(location.search);
  let kind: Kind = params.get('t') === URL_KIND.movies ? 'movies' : 'books';
  qEl.value = params.get('q') ?? '';
  sortEl.value = params.get('sort') ?? 'pop';
  if (!sortEl.value) sortEl.value = 'pop';
  GROUPS.forEach((g) => {
    const sel = params.getAll(g);
    boxes(kind, g).forEach((b) => { b.checked = sel.includes(b.value); });
  });

  const pl = (a: string, b: string) => a.localeCompare(b, 'pl');
  const cmp: Record<string, (a: RowItem, b: RowItem) => number> = {
    pop: (a, b) => b.lists.length - a.lists.length || pl(a.title, b.title),
    'year-asc': (a, b) => a.yearNum - b.yearNum,
    'year-desc': (a, b) => b.yearNum - a.yearNum,
    title: (a, b) => pl(a.title, b.title),
    age: (a, b) => a.ageNum - b.ageNum || pl(a.title, b.title),
  };

  // ─── Leniwe ładowanie: w DOM są tylko karty z bieżącej strony wyników (po PAGE sztuk) ───
  let matched: RowItem[] = [];
  let painted = 0;
  function paint(reset: boolean) {
    if (reset) { rowsEl.textContent = ''; painted = 0; }
    const chunk = matched.slice(painted, painted + PAGE);
    if (chunk.length) {
      rowsEl.insertAdjacentHTML('beforeend', chunk.map((i) => rowHtml(i, titles)).join(''));
      [...rowsEl.children].slice(-chunk.length).forEach((r) => syncRow(r as HTMLElement));
    }
    painted += chunk.length;
    const left = matched.length - painted;
    moreEl.hidden = left <= 0;
    moreEl.textContent = `Pokaż więcej (${Math.min(PAGE, left)} z ${left})`;
  }
  moreEl.addEventListener('click', () => paint(false));
  // doładowanie przy dojechaniu do końca listy
  new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting) && !moreEl.hidden) paint(false); }, { rootMargin: '600px' })
    .observe(moreEl);

  // ─── Aktywne filtry jako badge nad listą ───
  const chipsEl = $('chips');
  function chip(key: string, text: string, attrs: Record<string, string>) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'chip';
    b.title = 'Usuń filtr';
    Object.entries(attrs).forEach(([k, v]) => { b.dataset[k] = v; });
    const k = document.createElement('span'); k.className = 'chip-key'; k.textContent = key ? `${key}:` : '';
    const t = document.createElement('span'); t.className = 'chip-text'; t.textContent = text;
    const x = document.createElement('span'); x.className = 'chip-x'; x.textContent = '×'; x.setAttribute('aria-label', 'Usuń');
    b.append(...(key ? [k] : []), t, x);
    return b;
  }
  function renderChips(sel: Record<(typeof GROUPS)[number], string[]>, q: string) {
    const nodes: HTMLElement[] = [];
    if (q) nodes.push(chip('Szukaj', qEl.value.trim(), { chip: 'q' }));
    for (const g of GROUPS) {
      const label = panels[kind].querySelector(`[data-group="${g}"] .sidebar-label`)?.textContent?.trim() ?? g;
      for (const box of boxes(kind, g).filter((b) => b.checked)) {
        nodes.push(chip(label, box.parentElement!.textContent!.trim(), { chip: 'box', group: g, value: box.value }));
      }
    }
    if (nodes.length > 1) {
      const all = document.createElement('button');
      all.type = 'button'; all.className = 'chips-clear'; all.dataset.chip = 'all'; all.textContent = 'Wyczyść wszystko';
      nodes.push(all);
    }
    chipsEl.replaceChildren(...nodes);
    chipsEl.hidden = nodes.length === 0;
  }
  chipsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');
    if (!b) return;
    const type = b.dataset.chip;
    if (type === 'q' || type === 'all') qEl.value = '';
    if (type === 'all') GROUPS.forEach((g) => boxes(kind, g).forEach((c) => { c.checked = false; }));
    if (type === 'box') boxes(kind, b.dataset.group!).filter((c) => c.value === b.dataset.value).forEach((c) => { c.checked = false; });
    apply();
  });

  function apply() {
    const q = qEl.value.trim().toLowerCase();
    const sel = Object.fromEntries(GROUPS.map((g) => [g, checked(kind, g)])) as Record<(typeof GROUPS)[number], string[]>;

    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.kindBtn === kind)));
    (Object.keys(panels) as Kind[]).forEach((k) => { panels[k].hidden = k !== kind; });
    GROUPS.forEach((g) => {
      panels[kind].querySelector<HTMLElement>(`[data-clear="${g}"]`)?.classList.toggle('visible', sel[g].length > 0);
    });

    panels[kind].querySelectorAll<HTMLElement>('.msel').forEach((m) => {
      const names = [...m.querySelectorAll<HTMLInputElement>('input:checked')].map((b) => b.parentElement!.textContent!.trim());
      const text = m.querySelector<HTMLElement>('.msel-text')!;
      text.textContent = names.length === 0 ? 'Wszystkie listy' : names.length === 1 ? names[0] : `Wybrane listy: ${names.length}`;
      text.title = names.join('\n');
    });

    matched = items
      .filter((i) =>
        i.kind === kind &&
        (!q || texts.get(i.id)!.includes(q)) &&
        (!sel.genre.length || sel.genre.includes(i.genre)) &&
        (!sel.era.length || sel.era.includes(i.era)) &&
        (!sel.age.length || sel.age.includes(String(i.ageNum))) &&
        (!sel.pts.length || sel.pts.includes(String(i.lists.length))) &&
        (!sel.list.length || i.lists.some((s) => sel.list.includes(s))))
      .sort(cmp[sortEl.value] ?? cmp.pop);
    const shown = matched.length;
    paint(true);
    renderChips(sel, q);

    $('title').textContent = KIND_TITLE[kind];
    $('sub').textContent = `Wyświetlono ${shown} z ${totals[kind]} pozycji`;
    const active = GROUPS.reduce((n, g) => n + sel[g].length, 0);
    const nEl = $('filters-n');
    nEl.textContent = String(active);
    nEl.hidden = active === 0;
    $('drawer-apply').textContent = `Pokaż wyniki (${shown})`;
    $('empty').hidden = shown > 0;
    document.title = `${kind === 'books' ? 'Książki' : 'Filmy'} · nobestseller.com`;

    const next = new URLSearchParams();
    next.set('t', URL_KIND[kind]);
    if (q) next.set('q', qEl.value.trim());
    if (sortEl.value !== 'pop') next.set('sort', sortEl.value);
    GROUPS.forEach((g) => sel[g].forEach((v) => next.append(g, v)));
    history.replaceState(null, '', `?${next}`);
  }

  tabs.forEach((t) => t.addEventListener('click', () => { kind = t.dataset.kindBtn as Kind; apply(); }));
  qEl.addEventListener('input', apply);
  sortEl.addEventListener('change', apply);
  GROUPS.forEach((g) => (Object.keys(panels) as Kind[]).forEach((k) =>
    boxes(k, g).forEach((b) => b.addEventListener('change', apply))));
  document.querySelectorAll<HTMLElement>('[data-clear]').forEach((btn) => btn.addEventListener('click', () => {
    boxes(kind, btn.dataset.clear!).forEach((b) => { b.checked = false; });
    apply();
  }));

  // Ulubione i „Zaliczone”: stan przycisków na kartach
  subscribe(() => rowsEl.querySelectorAll<HTMLElement>('.row').forEach(syncRow));
  bindRows(rowsEl);

  // Klik w nazwę listy na karcie – pokaż tylko tę listę
  rowsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.src-badge');
    if (!b) return;
    boxes(kind, 'list').forEach((c) => { c.checked = c.value === b.dataset.list; });
    apply();
  });

  // ─── Select wielokrotnego wyboru („Źródło listy”) ───
  const menus = [...document.querySelectorAll<HTMLElement>('.msel')];
  const setMenu = (m: HTMLElement, open: boolean) => {
    m.querySelector<HTMLElement>('.msel-menu')!.hidden = !open;
    m.querySelector('.msel-btn')!.setAttribute('aria-expanded', String(open));
  };
  menus.forEach((m) => m.querySelector('.msel-btn')!.addEventListener('click', () => {
    const open = m.querySelector<HTMLElement>('.msel-menu')!.hidden;
    menus.forEach((x) => setMenu(x, false));
    setMenu(m, open);
  }));
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.msel')) menus.forEach((x) => setMenu(x, false));
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') menus.forEach((x) => setMenu(x, false)); });

  // ─── Drawer z filtrami (tablet/telefon) ───
  const sidebar = $('sidebar');
  const backdrop = $('backdrop');
  const filtersBtn = $('filters-btn');
  const setDrawer = (open: boolean) => {
    sidebar.classList.toggle('open', open);
    backdrop.hidden = !open;
    document.documentElement.classList.toggle('drawer-open', open);
    filtersBtn.setAttribute('aria-expanded', String(open));
    if (open) $('drawer-close').focus(); else if (document.activeElement && sidebar.contains(document.activeElement)) filtersBtn.focus();
  };
  filtersBtn.addEventListener('click', () => setDrawer(true));
  $('drawer-close').addEventListener('click', () => setDrawer(false));
  $('drawer-apply').addEventListener('click', () => setDrawer(false));
  backdrop.addEventListener('click', () => setDrawer(false));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && sidebar.classList.contains('open')) setDrawer(false); });
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => { if (e.matches) setDrawer(false); });

  apply();
</script>
