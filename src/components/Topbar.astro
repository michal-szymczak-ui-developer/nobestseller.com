---
interface Props { current?: 'catalog' | 'favorites'; }
const { current = 'catalog' } = Astro.props;
---
<nav class="topbar">
  <a href="/" class="wordmark">nobestseller</a>
  <div class="center">
    <slot name="center" />
    <a href="/ulubione/" class="fav-link" id="fav-link" aria-current={current === 'favorites' ? 'page' : undefined} title="Twoje ulubione">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 3h12v18l-6-4.5L6 21Z"/></svg>
      <span class="fav-label">Ulubione</span> <span id="fav-count">0</span>
    </a>
  </div>
  <div class="topbar-right">
    <slot name="right" />
    <span class="info-links">
      <a href="/o-nas/">O nas</a>
      <a href="/listy/">Listy</a>
    </span>
    <button type="button" class="auth-btn" id="auth-btn" hidden>Zaloguj się</button>
  </div>
</nav>

<style>
  .topbar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 40px; height: 52px; border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; background: var(--bg); z-index: 200;
  }
  .wordmark {
    font-family: 'Playfair Display Variable', serif; font-size: 18px; font-weight: 700;
    letter-spacing: -0.5px; color: var(--ink); text-decoration: none; justify-self: start;
  }
  /* wszystkie elementy środkowej grupy (przełącznik, Ulubione) mają tę samą wysokość */
  .center { display: flex; align-items: stretch; gap: 4px; height: 32px; }
  .topbar-right { display: flex; align-items: center; gap: 16px; justify-self: end; }
  .info-links { display: flex; align-items: center; gap: 14px; }
  .info-links a { font-size: 12px; color: var(--ink-mid); text-decoration: none; white-space: nowrap; }
  .info-links a:hover { color: var(--ink); text-decoration: underline; }
  .fav-link {
    display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; font-size: 12px;
    border: 1px solid var(--rule); color: var(--ink-mid); text-decoration: none; white-space: nowrap;
  }
  .fav-link:hover { border-color: var(--ink); color: var(--ink); }
  .fav-link[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .fav-link[aria-current='page'] svg { fill: currentColor; }
  .auth-btn {
    height: 32px; padding: 0 12px; font-size: 12px; background: none; border: 1px solid var(--rule);
    color: var(--ink-mid); cursor: pointer; white-space: nowrap;
  }
  .auth-btn:hover { border-color: var(--ink); color: var(--ink); }
  .auth-btn[hidden] { display: none; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  @media (max-width: 860px) {
    .topbar { padding: 0 16px; }
  }
  @media (max-width: 560px) {
    .topbar { grid-template-columns: auto 1fr; gap: 8px; }
    .wordmark { display: none; }
    .topbar-right { gap: 6px; }
    .info-links { display: none; } /* na telefonie linki są w stopce */
    .fav-label { display: none; }
    .fav-link { padding: 0 8px; }
    .auth-btn { padding: 0 8px; }
  }
</style>

<script>
  import { favs, initAuth, subscribe } from '../lib/favorites';

  const count = document.getElementById('fav-count')!;
  const showCount = () => { count.textContent = String(favs.size); };
  showCount();
  subscribe(showCount);
  initAuth(document.getElementById('auth-btn') as HTMLButtonElement);
</script>
